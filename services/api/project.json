{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "root": "services/api",
  "sourceRoot": "services/api",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m uvicorn main:app --host 127.0.0.1 --port 8000 --reload"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"Python API build: nothing to compile\""
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m pytest tests"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"Python API lint not configured yet\""
      }
    }
  },
  "tags": []
}
