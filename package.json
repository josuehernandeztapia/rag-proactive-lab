{
  "name": "rag-proactive-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Ecosistema completo de inteligencia artificial para análisis de riesgo crediticio",
  "scripts": {
    "build": "nx run-many --target=build --projects=api,dashboard",
    "test": "nx run-many --target=test --projects=api,dashboard",
    "lint": "nx run-many --target=lint --projects=api,dashboard",
    "start": "nx run-many --target=serve --projects=api,dashboard --parallel",
    "dev": "nx run-many --target=serve --projects=api,dashboard --parallel",
    "e2e": "echo 'No e2e target configured'",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "clean": "nx reset",
    "build-custom": "node build-custom.js",
    "build-safe": "(cd clients/dashboard && npm run build)",
    "test-safe": ".venv/bin/python -m pytest tests/ -v",
    "validate": ".venv/bin/python -c 'import fastapi; print(\"✅ RAG Lab Ready\")'"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "services/*",
    "clients/*"
  ],
  "devDependencies": {
    "@nx/eslint": "^20.2.0",
    "@nx/eslint-plugin": "^20.2.0",
    "@nx/js": "^20.8.2",
    "@nx/node": "^20.8.2",
    "@nx/react": "^20.8.2",
    "@nx/vite": "^20.8.2",
    "@nx/workspace": "^20.8.2",
    "autoprefixer": "^10.4.21",
    "nx": "^20.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/josuehernandeztapia/rag-proactive-lab.git"
  },
  "author": "Juan Josue Hernandez Tapia",
  "license": "MIT"
}
